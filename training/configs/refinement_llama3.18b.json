{
  "seed": 0,
  "nproc": 1,
  "gpus": [2],
  "device": "cuda",
  "joint_training_checkpoint": "${CUE_STORAGE_ROOT}/models/cue/best",
  "data_root": "${CUE_STORAGE_ROOT}/data",
  "split": "train",
  "validation_split": "validation",
  "output": "${CUE_STORAGE_ROOT}/models/cue",
  "resume": true,
  "train_decoder_lm": true,
  "max_train_examples": 50000,
  "sim_model": "hosted_vllm/meta-llama/Llama-3.1-8B-Instruct",
  "sim_api_base": "http://127.0.0.1:8000/v1",
  "sim_api_key_env": "HOSTED_VLLM_API_KEY",
  "sim_max_input_tokens": 8192,
  "sim_temperature": 0.7,
  "sim_max_tokens": 256,
  "sim_concurrency": 32,
  "task_instructions": "Role-play as the human user. Follow the persona manual and continue the conversation naturally. Return only the next user message.",
  "max_context_turns": 16,
  "probe_model": "Qwen/Qwen3-4B",
  "probe_device": "cuda",
  "probe_dtype": "bfloat16",
  "probe_batch_size": 16,
  "probe_max_length": 1024,
  "probe_seed_examples": 512,
  "probe_refit_max_pairs": 4096,
  "probe_validation_pairs": 256,
  "reward_cap_p": 0.8,
  "cue_reward_weight": 0.5,
  "cue_reward_margin": 0.1,
  "cue_reward_separation_weight": 1.0,
  "cue_reward_batch_size": 8,
  "num_candidates": 4,
  "sample_temperature": 0.9,
  "gen_max_new_tokens": 1024,
  "batch_sessions": 8,
  "epochs": 25,
  "steps_per_epoch": 250,
  "e_min": 2,
  "auc_chance_band": 0.05,
  "control_auc_min": 0.7,
  "auc_patience_k": 2,
  "buffer_max": 10000,
  "lr": 1e-6,
  "kl_beta": 0.001,
  "grpo_clip_eps": 0.2,
  "grpo_updates_per_batch": 1,
  "grad_clip": 1.0,
  "audit_every": 1,
  "leakage_audit_every": 1,
  "leakage_audit_samples": 32,
  "leakage_reward_gap": 0.05,
  "leakage_overlap_threshold": 0.2,
  "judge_panel": [
    {"model": "gpt-5.4-mini", "api_key_env": "OPENAI_API_KEY"},
    {"model": "anthropic/claude-haiku-4-5", "api_key_env": "ANTHROPIC_API_KEY"},
    {"model": "gemini/gemini-3.1-flash-lite", "api_key_env": "GOOGLE_API_KEY"}
  ],
  "wandb_project": "CUE",
  "wandb_entity": null,
  "wandb_name": "refinement-llama3.18b",
  "no_wandb": false
}
