{
  "seed": 0,
  "device": "cuda",
  "data_root": "${CUE_STORAGE_ROOT}/data",
  "output": "${CUE_STORAGE_ROOT}/models/cue",
  "split": "train",
  "batch_size": 4,
  "epochs": 3,
  "grad_accum": 8,
  "lr": 5e-5,
  "lr_backbone": 5e-6,
  "lr_lm": 5e-6,
  "lr_gate": 5e-4,
  "resume": false,
  "save_every": 100,
  "lm_format_warmup_steps": 200,
  "lambda_consistency": 0.1,
  "lambda_var": 1.0,
  "lambda_cov": 0.1,
  "lambda_cue_infonce": 0.1,
  "lambda_cue_style": 1.0,
  "cue_infonce_temp": 0.05,
  "cue_overlap_target_temp": 0.1,
  "cue_hard_session": true,
  "cue_positive_turn_dropout": 0.3,
  "dual_decode": true,
  "command_slot_decode": true,
  "general_command_slots": 5,
  "user_specific_command_slots": 5,
  "style_command_slots": 5,
  "slot_embedding_dim": 64,
  "command_noop_weight": 0.05,
  "lambda_dual_separation": 0.1,
  "dual_separation_margin": 0.2,
  "lambda_general_ce": 0.25,
  "lambda_user_specific_ce": 0.55,
  "lambda_style_ce": 0.40,
  "command_cache_size": 20000,
  "per_source_cap": 10000,
  "shuffle_buffer": 512,
  "grad_clip": 1.0,
  "log_every": 10,
  "dist_timeout_min": 30,
  "val_every": 100,
  "val_split": "validation",
  "val_per_source_cap": 32,
  "val_retrieval_cap": 512,
  "val_retrieval_batch_size": 256,
  "val_batch_size": 16,
  "val_max_batches": 16,
  "val_gen_samples": 16,
  "val_gen_max_tokens": 256,
  "example_retrieval_k_sessions": 8,
  "example_retrieval_n_general": 2,
  "example_retrieval_n_specific": 2,
  "target_max_tokens": 256,
  "wandb_project": "CUE",
  "wandb_entity": null,
  "wandb_name": "joint-training",
  "wandb_group": null,
  "no_wandb": false,
  "encoder": {
    "user_model_name": "nomic-ai/modernbert-embed-base",
    "system_model_name": "nomic-ai/modernbert-embed-base",
    "bottleneck_dim": 1024,
    "session_dim": 1024,
    "session_layers": 4,
    "session_heads": 8,
    "max_turns": 64,
    "max_length": 256,
    "query_prefix": "search_query: ",
    "passage_prefix": "search_document: "
  },
  "decoder": {
    "model_name": "Qwen/Qwen3-0.6B-Base",
    "num_persona_tokens": 16,
    "insert_every": 4,
    "num_heads": 8,
    "dtype": "bfloat16",
    "freeze_lm": false
  }
}
